-- 11. CHỨC NĂNG BAY QUANH NGƯỜI CHƠI
local orbitAngle = 0
local orbitRadius = 4.5
local orbitSpeed = 35

RunService.Stepped:Connect(function(deltaTime)
    if Config.OrbitPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local target = GetClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetHRP = target.Character.HumanoidRootPart
            local myHRP = LocalPlayer.Character.HumanoidRootPart
            
            orbitAngle = orbitAngle + (deltaTime * orbitSpeed)
            local offsetX = math.cos(orbitAngle) * orbitRadius
            local offsetZ = math.sin(orbitAngle) * orbitRadius
            local targetPos = targetHRP.Position + Vector3.new(offsetX, 1.5, offsetZ)
            
            myHRP.CFrame = CFrame.lookAt(targetPos, targetHRP.Position)
            myHRP.Velocity = Vector3.zero
        end
    end
end)


