-- 8. CHỨC NĂNG HITBOX TỐI ƯU CHỐNG LAG
task.spawn(function()
    while task.wait(0.2) do
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = v.Character.HumanoidRootPart
                if Config.HitboxAo then
                    if not OriginalSizes[v] then
                        OriginalSizes[v] = hrp.Size
                    end
                    
                    local currentSize = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    if hrp.Size ~= currentSize then
                        hrp.Size = currentSize
                        hrp.Transparency = 0.85
                        hrp.BrickColor = BrickColor.new("White")
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                    end
                    
                    if not HitboxOutlines[v] or HitboxOutlines[v].Parent ~= hrp then
                        if HitboxOutlines[v] then HitboxOutlines[v]:Destroy() end
                        local box = Instance.new("SelectionBox")
                        box.Name = "GbaoOutline"
                        box.Color3 = Color3.fromRGB(0, 0, 0)
                        box.LineThickness = 0.1
                        box.Adornee = hrp
                        box.Parent = hrp
                        HitboxOutlines[v] = box
                    end
                else
                    if OriginalSizes[v] and hrp.Size ~= OriginalSizes[v] then
                        hrp.Size = OriginalSizes[v]
                        hrp.Transparency = 1
                        hrp.CanCollide = true
                    end
                    if HitboxOutlines[v] then
                        HitboxOutlines[v]:Destroy()
                        HitboxOutlines[v] = nil
                    end
                end
            end
        end
    end
end)


